{
  "name": "ripple",
  "productName": "Ripple",
  "version": "3.4.0",
  "description": "A Dynamic Island for All",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "tsx scripts/start.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "oxlint --config .config/oxlint.json --deny-warnings",
    "typecheck": "tsc -p .config/tsconfig.main.json && tsc -p .config/tsconfig.preload.json && tsc -p .config/tsconfig.renderer.json && tsc -p .config/tsconfig.tools.json",
    "format": "prettier --config .config/prettier.json --ignore-path .config/prettierignore --write \"src/**/*.{ts,tsx,css,md}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.md\" \"package.json\" \"tsconfig.json\" \".github/**/*.{yml,yaml}\" \".config/**/*.{json,ts,mts,md}\"",
    "format:check": "prettier --config .config/prettier.json --ignore-path .config/prettierignore --check \"src/**/*.{ts,tsx,css,md}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.md\" \"package.json\" \"tsconfig.json\" \".github/**/*.{yml,yaml}\" \".config/**/*.{json,ts,mts,md}\"",
    "deadcode": "knip --config .config/knip.json",
    "duplicates": "jscpd --config .config/duplication.json src",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run deadcode && npm run duplicates",
    "test": "vitest run --config .config/vitest.config.mts"
  },
  "keywords": [],
  "author": {
    "name": "TopMyster",
    "email": "example@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-wix": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "lucide-react": "1.51.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "x11": "4.3.0"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11"
  },
  "config": {
    "forge": "./.config/forge.config.ts"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@bitdisaster/exe-icon-extractor@1.0.10": true
  }
}
